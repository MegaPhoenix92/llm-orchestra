# Database connection (use docker-compose for local development)
DATABASE_URL=postgresql://orchestra:orchestra_dev@localhost:5436/llm_orchestra

# JWT secret for authentication (generate a secure random string for production)
JWT_SECRET=your-secure-jwt-secret-here

# Optional: Encryption key for secrets at rest (32 bytes hex-encoded)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY=

# Optional: Azure AD SSO configuration
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=
